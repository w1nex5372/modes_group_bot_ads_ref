# =====================================================
# PAGRINDINIAI NUSTATYMAI
# =====================================================

# @BotFather sukurto referral/konkurso boto tokenas
BOT_TOKEN=

# Pagrindinė grupė. Viešai grupei: @username
# Privačiai galima naudoti -100... chat ID.
GROUP=@NERADAUDROPO

# Nebūtina, jei GROUP yra @username.
GROUP_PUBLIC_URL=

# Tavo Telegram user ID. Keli adminai: 123,456
# Jei paliksi tuščią, admin teisės tikrinamos pagal grupės adminus.
ADMIN_IDS=

DB_PATH=referrals.sqlite3

# =====================================================
# KONKURSAS / LEADERBOARD
# =====================================================

WEEK_TIMEZONE=Europe/Vilnius
WEEK_RESET_ANNOUNCE=true
LIVE_LEADERBOARD_ENABLED=true
LIVE_LEADERBOARD_REFRESH_SECONDS=60

# =====================================================
# USER ACCOUNT AUTOMATION
# =====================================================

API_ID=
API_HASH=
SESSION_NAME=tg_autoforward
SOURCE_CHAT=
SOURCE_MESSAGE_ID=0
INTERVAL_SECONDS=3600
PER_CHAT_DELAY_SECONDS=5
CHATS_FILE=chats.txt
ROSE_ADS_CHAT=
ROSE_BOT_USERNAME=
ROSE_COMMAND_DELETE_DELAY_SECONDS=3
