# PRADA LUX community theme
# Copy to .env only for the separate Prada group deployment.

BRAND_THEME=prada
PRADA_BRAND_NAME=PRADA LUX
PRADA_GROUP_LABEL=PRADA LUX CLUB
PRADA_DISCLAIMER=Neoficiali luxury fashion bendruomenė · nesusijusi su Prada S.p.A.

BOT_TOKEN=PAKEISK_BOT_TOKEN
ADMIN_IDS=TAVO_TELEGRAM_USER_ID

# Nauja Prada grupė
GROUP=@TAVO_PRADA_GRUPE
GROUP_CHAT=@TAVO_PRADA_GRUPE
GROUP_PUBLIC_URL=https://t.me/TAVO_PRADA_GRUPE

# Atskira DB, kad NERA DROPO duomenys nesimaišytų
DB_PATH=prada_referrals.sqlite3
WEEK_TIMEZONE=Europe/Vilnius
WEEK_RESET_ANNOUNCE=true
LIVE_LEADERBOARD_ENABLED=true
LIVE_LEADERBOARD_REFRESH_SECONDS=60

# Prada custom emoji pack IDs
EMOJI_IDS_FILE=emoji_ids_prada.json
ASSETS_DIR=assets

# Telegram user automation / Rose
API_ID=TAVO_API_ID
API_HASH=TAVO_API_HASH
SESSION_NAME=prada_autoforward
SOURCE_CHAT=@TAVO_PRADA_GRUPE
SOURCE_MESSAGE_ID=0
INTERVAL_SECONDS=3600
PER_CHAT_DELAY_SECONDS=5
CHATS_FILE=chats.txt

ROSE_ADS_CHAT=@TAVO_PRADA_GRUPE
ROSE_BOT_USERNAME=
ROSE_FAST_NOTES=konkursas,promo
ROSE_FAST_INTERVAL_MINUTES=15
ROSE_MIN_AD_GAP_SECONDS=120
ROSE_COMMAND_DELETE_DELAY_SECONDS=3
